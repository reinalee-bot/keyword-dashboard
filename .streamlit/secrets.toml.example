# ============================================================
# Streamlit secrets 예시 파일 — 실제 값을 넣어 secrets.toml로 복사하세요
# 이 파일(.example)은 GitHub에 올려도 안전합니다 (빈 값 예시만 포함)
# ============================================================

# GitHub 개인 액세스 토큰 (repo 권한 필요)
GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxx"

# GitHub 저장소 이름
GITHUB_REPO = "reinalee-bot/keyword-dashboard"

# ── GA4 Analytics ────────────────────────────────────────────
# GA4 관리 > 데이터 스트림 > 스트림 선택 > 측정 ID
GA4_MEASUREMENT_ID = "G-XXXXXXXXXX"

# GA4 관리 > 데이터 스트림 > Measurement Protocol API 보안 비밀
# 생성 경로: GA4 관리 > 데이터 스트림 > 스트림 > Measurement Protocol API 보안 비밀 > 만들기
GA4_API_SECRET = "xxxxxxxxxxxxxxxxxxxx"
